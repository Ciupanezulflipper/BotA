#!/data/data/com.termux/files/usr/bin/bash
# runit service: schedule BotA's unified heartbeat runtime.
#
# This wrapper never sends Telegram directly and never mutates services.

set -uo pipefail
exec 2>&1

ROOT="${BOTA_ROOT:-${HOME}/BotA}"
LOG="${ROOT}/logs/cron.heartbeat.log"
SCRIPT="${ROOT}/tools/heartbeat.sh"
INTERVAL="${BOTA_HEARTBEAT_INTERVAL_SEC:-60}"

case "${INTERVAL}" in
  ''|*[!0-9]*) INTERVAL=60 ;;
esac

if (( INTERVAL < 10 )); then
  INTERVAL=60
fi

mkdir -p "${ROOT}/logs"

log() {
  printf '[RUNIT bota-heartbeat %s] %s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    "$*" \
    | tee -a "${LOG}"
}

terminate() {
  log "SERVICE_STOP pid=$$"
  exit 0
}

trap terminate HUP INT TERM

log "SERVICE_START pid=$$ interval_sec=${INTERVAL} mutation=disabled"

while true; do
  if [[ -f "${SCRIPT}" ]]; then
    BOTA_ROOT="${ROOT}" bash "${SCRIPT}" \
      || log "heartbeat_exit rc=$?"
  else
    log "SKIP: heartbeat_script_missing path=${SCRIPT}"
  fi

  sleep "${INTERVAL}" &
  wait $!
done
